<section
  class="image-text-section"
  style="
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">

    <div class="image-text-wrapper {% if section.settings.image_position == 'right' %}reverse{% endif %}">

      <div class="image-column">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
            loading: 'lazy',
            class: 'section-image'
          }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>

      <div
        class="content-column"
        style="color: {{ section.settings.text_color }};"
      >

        {% if section.settings.subheading != blank %}
          <p class="section-subheading">
            {{ section.settings.subheading }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="section-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="section-text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="section-button"
          >
            {{ section.settings.button_label }}
          </a>
        {% endif %}

      </div>

    </div>

  </div>
</section>

<style>
    .image-text-wrapper{
    display:flex;
    align-items:center;
    gap:60px;
}

.image-text-wrapper.reverse{
    flex-direction:row-reverse;
}

.image-column,
.content-column{
    width:50%;
}

.section-image{
    width:100%;
    display:block;
    border-radius:10px;
    object-fit:cover;
}

.section-subheading{
    font-size:14px;
    text-transform:uppercase;
    letter-spacing:2px;
    margin-bottom:10px;
}

.section-heading{
    font-size:42px;
    line-height:1.2;
    margin-bottom:20px;
}

.section-text{
    font-size:18px;
    line-height:1.8;
    margin-bottom:30px;
}

.section-button{
    display:inline-block;
    padding:14px 32px;
    text-decoration:none;
    background:#000;
    color:#fff;
    border-radius:6px;
    transition:.3s;
}

.section-button:hover{
    opacity:.85;
}

@media(max-width:991px){

.image-text-wrapper,
.image-text-wrapper.reverse{
    flex-direction:column;
    gap:35px;
}

.image-column,
.content-column{
    width:100%;
}

.section-heading{
    font-size:30px;
}

.section-text{
    font-size:16px;
}

}
</style>

{% schema %}
{
  "name": "Custom Image with Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with Text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Content",
      "default": "<p>Add your content here.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Custom Image with Text"
    }
  ]
}
{% endschema %}